# scripts/lab/lab.env.example → 복사 위치: $TOOLING_ROOT/work/lab.env (chmod 600, 커밋·공유 금지)
# 비밀번호 · 토큰 · access key · SSO 캐시는 넣지 않습니다. 값은 해당 주제에서 채웁니다.

TOOLING_ROOT="$HOME/commerce-platform/eks-platform-tooling"
INFRA_ROOT="$HOME/commerce-platform/cloud-platform-infrastructure"
WEB_ROOT="$HOME/commerce-platform/commerce-web"
API_ROOT="$HOME/commerce-platform/commerce-api"
GITHUB_ORG="" # 01-GITHUB-SETUP: 예: play-builder-labs (본인이 만든 조직명)
DEV_STATE_BUCKET=""                                       # backend-migration (Dev State 버킷 이름, 뒤 루트 모듈의 backend.hcl 에 사용)
PROD_STATE_BUCKET=""                                      # prod-state-foundation (Prod State 버킷 이름)
AWS_REGION="ap-northeast-2"                               # 02-AWS-SETUP
SSO_START_URL=""                                          # 02-AWS-SETUP (AWS access portal URL)
SSO_REGION=""                                             # 02-AWS-SETUP (Identity Center 리전)

MANAGEMENT_PROFILE="platform-management"                    # 02-AWS-SETUP
NETWORK_PROFILE="shared-network"
DEV_PROFILE="commerce-development"
PROD_PROFILE="commerce-production"

MANAGEMENT_ACCOUNT_ID=""                                  # 02-AWS-SETUP (12자리)
NETWORK_ACCOUNT_ID=""
DEV_ACCOUNT_ID=""
PROD_ACCOUNT_ID=""

DEV_OPERATOR_ROLE_ARN=""                                  # 02-AWS-SETUP 13절 (IAM 역할 ARN)
PROD_OPERATOR_ROLE_ARN=""

PARENT_DOMAIN=""                          # 02-AWS-SETUP 14절
PARENT_ZONE_ID=""                                         # 02-AWS-SETUP 14절

DEV_KUBE_CONTEXT=""                                       # CLUSTER_CONTROL (kubectl context 이름)
PROD_KUBE_CONTEXT=""                                      # PRODUCTION_PLATFORM
