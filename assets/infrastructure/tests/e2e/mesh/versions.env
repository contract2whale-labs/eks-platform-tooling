# tests/e2e/mesh/versions.env
# 서비스 메시: Istio chart 4개(base · cni · istiod · ztunnel)의 버전과 출처, 호환성 검사 기준을 한 곳에 고정합니다. scripts/*.sh 가 source 로 읽습니다.
# 버전 · 지원 목록은 조회 결과입니다 (2026-08-27 기준 Helm index 와 Istio Supported Releases 표; 뒤 회차에서 재확인).
ISTIO_VERSION=1.30.4                                                     # 예: 1.30.4 (chart 4개를 같은 버전으로 고정; appVersion 도 1.30.4)
ISTIO_HELM_REPO=https://istio-release.storage.googleapis.com/charts       # 예: Istio 공식 Helm 저장소 (helm pull --repo 에 그대로 사용)
ISTIO_SUPPORTED_KUBERNETES="1.32 1.33 1.34 1.35 1.36"                    # 예: Istio 1.30 이 지원하는 Kubernetes 마이너 목록 (Supported Releases 표)
KUBERNETES_VERSION=1.36.0                                                # 예: 1.36.0 (렌더링과 schema 검사가 가정하는 API 버전; EKS 1.36)
MESH_GATEWAY_CLASS_NAME=mesh-internal                                    # 예: mesh-internal (컨트롤 플레인이 기본으로 관리할 GatewayClass 이름; gitops/platform/istiod/values/dev.yaml과 같은 값)
MESH_GATEWAY_CONTROLLER_NAME=istio.io/mesh-gateway-controller            # 예: istio.io/mesh-gateway-controller (그 GatewayClass 의 controllerName)
EDGE_GATEWAY_CLASS=platform                                              # 예: platform (외부 Gateway controller가 소유하는 GatewayClass 이름; 이 챕터는 건드리지 않음)
EDGE_GATEWAY_CONTROLLER=gateway.envoyproxy.io/gatewayclass-controller    # 예: Gateway 의 GatewayClass controllerName (설치 뒤 불변 확인)
