# platform/environments/dev/queue/versions.env
# 메시지 큐 전환: 관리형 큐 전환이 쓰는 chart · 이미지 · release 이름을 한 곳에 고정합니다. scripts/*.sh 가 source 로 읽습니다.
# chart 는 관측 파이프라인 가 이미 받아 둔 파일을 그대로 씁니다 (platform/environments/dev/observability/charts/tempo-distributed-3.5.1.tgz · charts.sha256 로 대조).
TEMPO_CHART_VERSION=3.5.1                                   # 예: 3.5.1 (관측 파이프라인 와 같은 chart; appVersion 3.0.3)
TEMPO_CHART_FILE=charts/tempo-distributed-3.5.1.tgz         # 예: 관측 파이프라인 observability 디렉터리 기준의 chart 파일 경로
TEMPO_SELF_MANAGED_IMAGE_VERSION=3.0.3                      # 예: 3.0.3 (관측 파이프라인 epoch 1 · 복귀 epoch 3 이 쓰는 공식 release 이미지; SASL/PLAIN 평문만 지원)
TEMPO_MANAGED_IMAGE_VERSION=main-6047d8b-1995-1             # 예: main-6047d8b-1995-1 (PR 7586 "distributor: add configurable Kafka SASL mechanism and TLS support" 병합 commit 6047d8b 의 공식 main 이미지 — MSK 의 SCRAM+TLS 경로에 필요; release 버전 아님)
TEMPO_MANAGED_SOURCE_COMMIT=6047d8b1cfc44053428647959c3da68b8dcf8d21 # 예: 이미지가 만들어진 Tempo commit (원본 병렬 설정과 연결 시험 의 source_commit 과 같은 값)
TEMPO_E1_RELEASE=platform-tempo                             # 예: platform-tempo (트레이스 파이프라인 연결 의 자체 구축 epoch 1 release)
TEMPO_E2_RELEASE=platform-tempo-e2                          # 예: platform-tempo-e2 (병렬 설정과 연결 시험 의 관리형 큐 epoch 2 release)
TEMPO_E3_RELEASE=platform-tempo-e3                          # 예: platform-tempo-e3 (전환 검증과 복귀 의 자체 구축 복귀 epoch 3 release)
GATEWAY_RELEASE=collection-gateway                          # 예: collection-gateway (수집 게이트웨이 의 수집 게이트웨이 release; 유입 중단 · 재개가 이 release 를 올림)
OTEL_COLLECTOR_CHART_VERSION=0.173.1                        # 예: 0.173.1 (게이트웨이 chart; 관측 파이프라인 versions.env 와 같은 값)
STRIMZI_VERSION=1.2.0                                       # 예: 1.2.0 (관리자 Pod 의 Kafka 클라이언트 이미지 앞부분)
KAFKA_VERSION=4.3.1                                         # 예: 4.3.1 (관리자 Pod 의 Kafka 클라이언트 이미지 뒷부분; MSK 브로커 버전과 다를 수 있으므로 승인한 브로커와 SCRAM/TLS 연결 시험으로 호환성을 확인)
QUEUE_ADMIN_USERNAME=queue-admin                            # 예: queue-admin (토픽 · ACL 을 만드는 동안에만 존재하는 관리 사용자)
KUBERNETES_VERSION=1.36.0                                   # 예: 1.36.0 (helm template --kube-version · kubeconform 에 넘기는 값)
