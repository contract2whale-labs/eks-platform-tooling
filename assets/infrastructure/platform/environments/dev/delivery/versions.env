# platform/environments/dev/delivery/versions.env
# 동기화 엔진과 상태: 배포 플랫폼 chart 버전과 로컬 검사 설정입니다 (2026-08 기준 릴리스, 2026-09-17 확인 — _qa/verified-refs.md). Argo CD는 bootstrap/argocd/bootstrap.py에 명시한 chart 버전으로 준비하며, 다른 chart는 gitops/clusters/<env>/apps/*.yaml의 targetRevision과 대조합니다.
ARGOCD_CHART_VERSION=10.9.0                                                     # 예: 10.9.0 (chart 버전; app v3.5.2 — GitOps 동기화 엔진; argocd CLI 3.5.2 와 같은 버전)
ARGOCD_VERSION=v3.5.2                                                           # 예: v3.5.2
ARGO_ROLLOUTS_CHART_VERSION=2.43.1                                              # 예: 2.43.1 (app v1.10.0 — canary · analysis controller; kubectl-argo-rollouts 1.10.0)
ARGO_ROLLOUTS_VERSION=v1.10.0                                                   # 예: v1.10.0
GATEWAY_API_PLUGIN_VERSION=v0.17.0                                              # 예: v0.17.0 (argoproj-labs/rollouts-plugin-trafficrouter-gatewayapi; sha256 는 values/argo-rollouts.yaml)
KYVERNO_CHART_VERSION=3.9.0                                                     # 예: 3.9.0 (app v1.19.0 — 어드미션 정책; kyverno CLI 1.19.0)
KYVERNO_VERSION=v1.19.0                                                         # 예: v1.19.0
RELOADER_CHART_VERSION=2.2.17                                                   # 예: 2.2.17 (app v1.4.22 — Secret · ConfigMap 변경 시 롤링 재기동)
ARGO_HELM_REPO=https://argoproj.github.io/argo-helm                             # 예: Argo 공식 Helm 저장소 (argo-cd · argo-rollouts)
KYVERNO_HELM_REPO=https://kyverno.github.io/kyverno/                            # 예: Kyverno 공식 Helm 저장소
RELOADER_HELM_REPO=https://stakater.github.io/stakater-charts                   # 예: Stakater 공식 Helm 저장소
KUBERNETES_VERSION=1.36.0                                                       # 예: 1.36.0 (helm template --kube-version · kubeconform 에 넘기는 값; EKS 1.36)
CRD_SCHEMA_LOCATION='gitops/schemas/{{.Group}}/{{.ResourceKind}}_{{.ResourceAPIVersion}}.json' # 예: 승인된 CRD schema를 이 경로에 먼저 공급해야 함 (현재 전달본에 schema 미공급; 실제 검사 전 선행 준비)
