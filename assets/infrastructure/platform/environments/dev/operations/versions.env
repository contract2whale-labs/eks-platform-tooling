# platform/environments/dev/operations/versions.env
# 해시는 charts.sha256 에 있습니다. 승인한 chart 파일과 주소·해시를 수동으로 대조합니다. 버전을 올릴 때는 주소 · 해시 · 이미지 버전을 함께 바꿉니다.
FLUENT_BIT_CHART_VERSION=0.58.1                                                                                                                  # 예: 0.58.1 (chart 버전; chart 기본 app 5.1.1)
FLUENT_BIT_CHART_URL=https://github.com/fluent/helm-charts/releases/download/fluent-bit-0.58.1/fluent-bit-0.58.1.tgz                              # 예: 공식 배포 파일 주소
FLUENT_BIT_IMAGE_TAG=5.1.1                                                                                                                       # 예: 5.1.1 (gitops/platform/fluent-bit/values/<environment>.yaml 의 image.tag 와 같은 값)
CLUSTER_AUTOSCALER_CHART_VERSION=9.59.0                                                                                                          # 예: 9.59.0 (chart 버전; chart 기본 app 1.35.0)
CLUSTER_AUTOSCALER_CHART_URL=https://github.com/kubernetes/autoscaler/releases/download/cluster-autoscaler-chart-9.59.0/cluster-autoscaler-9.59.0.tgz # 예: 공식 배포 파일 주소
CLUSTER_AUTOSCALER_IMAGE_TAG=v1.36.1                                                                                                             # 예: v1.36.1 (EKS 1.36 과 같은 minor; gitops/platform/cluster-autoscaler/values/<environment>.yaml 의 image.tag)
EXTERNAL_SECRETS_CHART_VERSION=2.10.0                                                                                                            # 예: 2.10.0 (chart 버전; app v2.10.0)
EXTERNAL_SECRETS_CHART_URL=https://github.com/external-secrets/external-secrets/releases/download/helm-chart-2.10.0/external-secrets-2.10.0.tgz    # 예: 공식 배포 파일 주소
VELERO_CHART_VERSION=12.1.0                                                                                                                      # 예: 12.1.0 (chart 버전; chart 기본 app 1.18.1)
VELERO_CHART_URL=https://github.com/vmware-tanzu/helm-charts/releases/download/velero-12.1.0/velero-12.1.0.tgz                                    # 예: 공식 배포 파일 주소
VELERO_IMAGE_TAG=v1.18.2                                                                                                                         # 예: v1.18.2 (gitops/platform/velero/values/<environment>.yaml 의 image.tag)
VELERO_AWS_PLUGIN_TAG=v1.14.2                                                                                                                    # 예: v1.14.2 (velero-plugin-for-aws initContainer 버전)
METRICS_SERVER_CHART_VERSION=3.14.0                                                                                                              # 예: 3.14.0 (chart 버전; app 0.9.0)
METRICS_SERVER_CHART_URL=https://github.com/kubernetes-sigs/metrics-server/releases/download/metrics-server-helm-chart-3.14.0/metrics-server-3.14.0.tgz # 예: 공식 배포 파일 주소
KUBERNETES_VERSION=1.36.0                                                                                                                        # 예: 1.36.0 (helm template --kube-version · kubeconform 에 넘기는 값; EKS 1.36)
