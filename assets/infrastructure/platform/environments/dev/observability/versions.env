# platform/environments/dev/observability/versions.env
KUBE_PROMETHEUS_STACK_VERSION=88.6.2                                              # 예: 88.6.2 (Prometheus Operator v0.93.1 · Grafana chart 12.11.2 · node-exporter chart 4.56.3 포함)
KUBE_PROMETHEUS_STACK_REPO=https://prometheus-community.github.io/helm-charts     # 예: prometheus-community 공식 Helm 저장소 (helm pull --repo)
THANOS_VERSION=v0.41.0
LOKI_CHART_VERSION=18.13.0                                                        # 예: 18.13.0 (grafana-community loki chart; appVersion 3.7.7 = 이미지 버전)
LOKI_CHART_REPO=https://grafana-community.github.io/helm-charts                   # 예: grafana-community 공식 Helm 저장소 (loki chart 는 2025 년부터 이 저장소)
LOKI_IMAGE_VERSION=3.7.7                                                          # 예: 3.7.7 (loki-values.yaml 의 loki.image.tag 와 같은 값)
KUBERNETES_VERSION=1.36.0                                                         # 예: 1.36.0 (helm template --kube-version · kubeconform 에 넘기는 값; EKS 1.36)
MONITORING_RELEASE=platform-monitoring                                            # 예: platform-monitoring (kube-prometheus-stack release 이름; ServiceMonitor 의 release label 값)
LOKI_RELEASE=platform-loki                                                        # 예: platform-loki (loki release 이름; 계약의 loki_endpoint 가 platform-loki-gateway 로 조립됨)
OTEL_COLLECTOR_CHART_VERSION=0.173.1                                              # 예: 0.173.1 (opentelemetry-collector chart; appVersion 0.160.0)
OTEL_COLLECTOR_REPO=https://open-telemetry.github.io/opentelemetry-helm-charts   # 예: 공식 Helm 저장소 (helm pull --repo)
OTEL_COLLECTOR_IMAGE_VERSION=0.160.0                                              # 예: 0.160.0 (otel/opentelemetry-collector-contrib; values 의 image.tag 와 같은 값)
STRIMZI_VERSION=1.2.0                                                             # 예: 1.2.0 (strimzi-kafka-operator chart = 운영자 이미지 버전; Kafka CR API v1)
STRIMZI_CHART_URL=https://github.com/strimzi/strimzi-kafka-operator/releases/download/1.2.0/strimzi-kafka-operator-helm-3-chart-1.2.0.tgz # 예: GitHub release 파일; 승인된 charts.sha256을 별도 준비하고 이 파일 bytes와 대조 (현재 전달본에 checksum 미공급)
KAFKA_VERSION=4.3.1                                                               # 예: 4.3.1 (Strimzi 1.2.0 kafka-versions.yaml 의 default; 53-queue-cluster.yaml 의 version)
KAFKA_METADATA_VERSION=4.3-IV0                                                    # 예: 4.3-IV0 (위 버전의 metadata 짝; 53-queue-cluster.yaml 의 metadataVersion)
TEMPO_CHART_VERSION=3.5.1                                                         # 예: 3.5.1 (tempo-distributed chart; appVersion 3.0.3 — Kafka 경로가 기본인 Tempo 3.0)
TEMPO_CHART_REPO=https://grafana-community.github.io/helm-charts                  # 예: grafana-community 저장소 (grafana.github.io에서 3.5.1 부재를 확인한 이전 기준선; 이번 변경의 실측 아님)
TEMPO_IMAGE_VERSION=3.0.3                                                         # 예: 3.0.3 (grafana/tempo 공식 이미지; tempo-values.yaml 의 tempo.image.tag)
GATEWAY_RELEASE=collection-gateway
AGENT_RELEASE=collection-agent
QUEUE_OPERATOR_RELEASE=queue-operator
TEMPO_RELEASE=platform-tempo
