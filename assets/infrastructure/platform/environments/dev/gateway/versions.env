# platform/environments/dev/gateway/versions.env
# Gateway · 인증서 선언 생성기: 2026-09-08 기준 공식 release 와 chart 를 고정했습니다. scripts/*.sh 가 source 로 읽는 shell 설정입니다.
LBC_VERSION=3.5.0                  # 예: 3.5.0 (AWS Load Balancer Controller chart 와 app 버전; https://aws.github.io/eks-charts)
ENVOY_GATEWAY_VERSION=v1.9.1       # 예: v1.9.1 (Envoy Gateway chart 버전; oci://docker.io/envoyproxy/gateway-helm)
EXTERNAL_DNS_CHART_VERSION=1.21.1  # 예: 1.21.1 (ExternalDNS chart 버전; chart 기본 app 0.21.0)
EXTERNAL_DNS_IMAGE_VERSION=v0.22.0 # 예: v0.22.0 (external-dns-values.yaml 의 image.tag 와 같은 값)
CERT_MANAGER_VERSION=v1.21.1       # 예: v1.21.1 (클러스터 보안 기반 이 설치한 release 와 같은 chart; DNS 확인 경로 값을 더할 때 사용)
KUBERNETES_VERSION=1.36.0          # 예: 1.36.0 (helm template --kube-version · kubeconform 에 넘기는 값; EKS 1.36)
