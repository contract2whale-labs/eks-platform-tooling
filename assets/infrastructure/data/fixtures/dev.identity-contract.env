# 실제 값이 아닙니다 (AWS 에 없는 fixture). 실제 파일은 platform/environments/dev/application/identity-contract.env 로 저장하며 커밋하지 않습니다.
IDENTITY_ENVIRONMENT=dev
IDENTITY_CLUSTER_NAME=contract2whale-dev-eks
IDENTITY_NAMESPACE=contract2whale-demo
IDENTITY_RUNTIME_ROLE_ARN=arn:aws:iam::111111111111:role/platform/contract2whale-dev-eks-app-runtime
IDENTITY_RUNTIME_SERVICE_ACCOUNT=commerce-api
IDENTITY_OPERATOR_ROLE_ARN=arn:aws:iam::111111111111:role/platform/contract2whale-dev-eks-app-database-operator
IDENTITY_OPERATOR_SERVICE_ACCOUNT=database-operator
IDENTITY_MIGRATION_ROLE_ARN=arn:aws:iam::111111111111:role/platform/contract2whale-dev-eks-delivery-migration
IDENTITY_MIGRATION_SERVICE_ACCOUNT=delivery-migration
IDENTITY_SECRETS_ROLE_ARN=arn:aws:iam::111111111111:role/platform/contract2whale-dev-eks-data-app-secrets
