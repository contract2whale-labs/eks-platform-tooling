# tools/database-operator/image.lock.env — 운영자 이미지의 고정값 (데이터베이스 운영자 이미지와 읽기 전용 진단). build.sh · install-*.sh 가 source 합니다. 값을 바꾸면 이미지 digest 가 바뀌고 초기화 · 진단 Job 의 이미지 참조를 다시 넣어야 합니다.
# 해시 값은 빌드하는 사람이 공식 레지스트리(public ECR) · 다운로드 URL 에서 받아 적습니다 (아래 명령). 비어 있으면 build.sh · install-*.sh 가 중단합니다 — 해시 없이 설치하지 않습니다.
BASE_IMAGE="public.ecr.aws/amazonlinux/amazonlinux:2023"                       # 예: Amazon Linux 2023 (dnf 로 bash · jq · postgresql17 클라이언트 설치)
BASE_IMAGE_DIGEST=""                                                           # 예: "sha256:…" — docker buildx imagetools inspect public.ecr.aws/amazonlinux/amazonlinux:2023 --format '{{json .Manifest.Digest}}' 로 받은 값
AWSCLI_VERSION="2.36.44"                                                       # 예: 도구 저장소 tool-versions 의 awscli 와 같은 값 (tools/delivery-tools 와 동일)
AWSCLI_ZIP_SHA256=""                                                           # 예: curl -fsSLo awscli.zip "https://awscli.amazonaws.com/awscli-exe-linux-x86_64-2.36.44.zip" && sha256sum awscli.zip 로 받은 값
POSTGRESQL_CLIENT_PACKAGE="postgresql17"                                       # 예: AL2023 의 PostgreSQL 17 클라이언트 패키지 (psql; 서버 엔진 17.x 와 같은 major)
RDS_CA_BUNDLE_URL="https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem" # 예: RDS 전역 CA 묶음 (모든 리전의 서버 인증서를 검증)
RDS_CA_BUNDLE_SHA256=""                                                        # 예: curl -fsSLo global-bundle.pem "$RDS_CA_BUNDLE_URL" && sha256sum global-bundle.pem 로 받은 값
TARGET_PLATFORM="linux/amd64"                                                  # 예: app 노드 그룹(m7i, x86_64) — arm 빌드 머신에서도 이 값으로 빌드
