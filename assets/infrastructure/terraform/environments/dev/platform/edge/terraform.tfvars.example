# terraform.tfvars.example — dev platform/edge 루트 모듈
# terraform.tfvars 로 복사한 뒤 expected_account_id · state_bucket_name 을 work/lab.env 의 DEV_ACCOUNT_ID · DEV_STATE_BUCKET 으로 바꿉니다.
# terraform.tfvars 는 커밋하지 않습니다. gateway_contract 는 입력하지 않습니다 (remote-state.tf 가 platform/gateway State 에서 읽음). Dev 는 enabled = false 로 둡니다.

expected_account_id = "111111111111"                     # 예: 12자리 AWS 계정 번호 (DEV_ACCOUNT_ID)
region              = "ap-northeast-2"                   # 예: "ap-northeast-2"
environment         = "dev"                              # 예: "dev" (이 디렉터리는 dev 만 허용)
state_bucket_name   = "company-dev-tfstate-111111111111" # 예: backend.hcl 의 bucket 과 같은 Dev State 버킷 (DEV_STATE_BUCKET)
enabled             = false                              # 예: false (Dev 는 CloudFront · WAF 를 만들지 않음; Prod 는 CloudFront 와 WAF 로 공개 서비스 완성)
nlb_arn             = ""                                 # 예: "" (켤 때만 aws elbv2 describe-load-balancers 로 확인한 ARN)
hostnames           = []                                 # 예: [] (켤 때만 ["dev.playdevops.click"])
origin_tls_ready    = false                              # 예: false (production 인증서 확인 뒤 true)
rate_limit_per_5min = 2000                               # 예: 2000
