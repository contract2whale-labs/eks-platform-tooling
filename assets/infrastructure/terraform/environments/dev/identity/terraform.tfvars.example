# terraform.tfvars.example — dev identity 루트 모듈
# 데이터 루트 모듈과 PostgreSQL 버전 고정: terraform.tfvars 로 복사한 뒤 expected_account_id · state_bucket_name 을 work/lab.env 의 DEV_ACCOUNT_ID · DEV_STATE_BUCKET 으로 바꿉니다. terraform.tfvars 는 커밋하지 않습니다.

expected_account_id = "111111111111"                     # 예: 12자리 AWS 계정 번호 (DEV_ACCOUNT_ID)
region              = "ap-northeast-2"                   # 예: "ap-northeast-2"
environment         = "dev"                              # 예: "dev" (이 디렉터리는 dev 만 허용)
state_bucket_name   = "company-dev-tfstate-111111111111" # 예: backend.hcl 의 bucket 과 같은 Dev State 버킷 (DEV_STATE_BUCKET)
