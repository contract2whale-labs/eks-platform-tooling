# backend.hcl.example — prod account-baseline 루트 모듈
# backend.hcl 로 복사한 뒤 bucket 과 allowed_account_ids 를 work/lab.env 의 PROD_STATE_BUCKET · PROD_ACCOUNT_ID 로 바꿉니다.
# 사용: terraform init -backend-config=backend.hcl   (lab.sh 의 up · down 도 같은 방식으로 초기화)

bucket              = "company-prod-tfstate-222222222222"   # 예: state 이 만든 Prod State 버킷 (Dev 버킷과 다른 계정)
key                 = "account-baseline/terraform.tfstate" # 예: Dev 와 같은 key (버킷 · 계정이 다르므로 충돌 없음)
region              = "ap-northeast-2"                      # 예: 버킷이 있는 리전
encrypt             = true                                  # 예: true (State 객체 저장 암호화)
use_lockfile        = true                                  # 예: true (State key 뒤 .tflock 객체로 동시 실행 차단)
allowed_account_ids = ["222222222222"]                      # 예: ["222222222222"] (State 접근 계정 제한)
